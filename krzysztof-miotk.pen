                    0,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "SbeB3",
                      "name": "Czym jest segmentacja klientów i czym wy",
                      "context": "h2",
                      "fill": "#15172c",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 201.56,
                      "content": "Czym jest segmentacja klientów i czym wyróżniają się efekty mojej pracy?",
                      "lineHeight": 0.9,
                      "fontFamily": "Nexa",
                      "fontSize": 56,
                      "fontWeight": "500",
                      "letterSpacing": -1.68
                    },
                    {
                      "type": "text",
                      "id": "X35GC",
                      "name": "Segmentacja klientów pozwala na dobre zr",
                      "context": "p",
                      "fill": "#3a3d52",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 54.38,
                      "content": "Segmentacja klientów pozwala na dobre zrozumienie grupy docelowej i wypracowaniu dla niej działań produktowych i marketingowych.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "EQ4zw",
                      "name": "Przy odpowiednim wdrożeniu pozwala śledz",
                      "context": "p",
                      "fill": "#3a3d52",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 54.38,
                      "content": "Przy odpowiednim wdrożeniu pozwala śledzić klientów i projektować ich przejścia na bardziej rentowne archetypy (persony).",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "revu5",
                      "name": "Przy pracy ze mną:",
                      "context": "p",
                      "fill": "#3a3d52",
                      "content": "Przy pracy ze mną:",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "lndyd",
                      "name": "ol",
                      "context": "ol",
                      "width": "fill_container",
                      "layout": "vertical",
                      "padding": [
                        0,
                        0,
                        0,
                        40
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "mMH6o",
                          "name": "Wypracujemy (wspólnie) wskaźniki zachowa",
                          "context": "li",
                          "fill": "#15172c",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 81.56,
                          "content": "Wypracujemy (wspólnie) wskaźniki zachowań ludzi w Twoim produkcie. Na bazie tego podzielimy ludzi tak, aby firma wiedziała jak komunikować się do poszczególnych segmentów i jak budować produkt(y) dla nich.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "FkvjE",
                          "name": "Stworzę od zera szablon segmentu dostoso",
                          "context": "li",
                          "fill": "#15172c",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 81.56,
                          "content": "Stworzę od zera szablon segmentu dostosowany do kontekstu Twojej firmy, który uzupełnimy o dane, które zbiorę. Zero „gotowych wzorców”, które po prostu nie sprawdzają się w biznesie.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "S7WdD",
                          "name": "Odkryję bolączki i potrzeby klientów, ab",
                          "context": "li",
                          "fill": "#15172c",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 54.38,
                          "content": "Odkryję bolączki i potrzeby klientów, aby firma wiedziała jakie wartości przedstawiać klientom (te wartości też możemy wspólnie wypracować).",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "n3gFK",
                          "name": "Przeprowadzę warsztaty, które pozwolą Tw",
                          "context": "li",
                          "fill": "#15172c",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 81.56,
                          "content": "Przeprowadzę warsztaty, które pozwolą Twojej firmie śledzić za pomocą analityki swoich użytkowników tak, aby móc wpływać na ich zachowania (ponowne zakupy, przejście na segment bardziej rentowny).",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
