                    {
                      "type": "text",
                      "id": "R9lKk5",
                      "name": "Czym jest audyt UX w moim wykonaniu?",
                      "context": "h2",
                      "fill": "#15172c",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 100.78,
                      "content": "Czym jest audyt UX w moim wykonaniu?",
                      "lineHeight": 0.9,
                      "fontFamily": "Nexa",
                      "fontSize": 56,
                      "fontWeight": "500",
                      "letterSpacing": -1.68
                    },
                    {
                      "type": "text",
                      "id": "IFPA6",
                      "name": "Audyt UX/UI bierze pod uwagę kontekst bi",
                      "context": "p",
                      "fill": "#3a3d52",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 81.56,
                      "content": "Audyt UX/UI bierze pod uwagę kontekst biznesu, rynku, w którym uczestniczy badany produkt oraz wzorce projektowe bazujące na Heurystykach Nielsena oraz naukach kognitywistycznych.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "wMCGS",
                      "name": "Do całości zostaje dodane moje doświadcz",
                      "context": "p",
                      "fill": "#3a3d52",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 54.38,
                      "content": "Do całości zostaje dodane moje doświadczenie, czyli tysiące godzin z różnymi produktami i branżami.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "oXwNW",
                      "name": "Dzięki temu mój audyt pozwala zwiększyć ",
                      "context": "p",
                      "fill": "#3a3d52",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 81.56,
                      "content": "Dzięki temu mój audyt pozwala zwiększyć konwersję na wielu etapach, zwiększyć ROI z marketingu, oraz wpłynąć na retencję (powracalność) obecnych klientów.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Z8unY",
                      "name": "Każdy błąd jest podzielony według 3-stop",
                      "context": "p",
                      "fill": "#3a3d52",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 81.56,
                      "content": "Każdy błąd jest podzielony według 3-stopniowej skali, co pozwala zarządzić Ci priorytetami zmian (i budżetem). A do tego do każdego błędu otrzymujesz rekomendację jak naprawić ten błąd.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "FTsui",
