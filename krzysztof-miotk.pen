            { "id": "o-r1", "type": "frame", "layout": "horizontal", "gap": 42, "width": "fill_container", "children": [ { "id": "o-r1-a", "type": "rectangle", "width": 64, "height": 64, "fill": "#DCDCE1" }, { "id": "o-r1-b", "type": "frame", "layout": "vertical", "gap": 24, "children": [ { "id": "o-r1-q", "type": "text", "content": "„Współpraca z Krzyśkiem to comiesięczna oszczędność na designie i wdrożeniach, a także gwarancja zawsze trafionych decyzji UX-owych. Krzysiek nie przytakuje — konfrontuje się z nami, pozostając partnerem w dyskusji, i przenosi doświadczenie z różnych branż na nasz produkt.\"", "fontFamily": "$font.body", "fontStyle": "italic", "fontSize": 20, "lineHeight": 30, "fill": "#2B2D42", "textGrowth": "fixed-width", "width": 1090 }, { "id": "o-r1-c", "type": "text", "content": "Jarek Piotrowski ·\nProduct Manager @Traffit", "fontFamily": "$font.mono", "fontSize": 15, "lineHeight": 24, "fill": "$color.ink" } ] } ] },
