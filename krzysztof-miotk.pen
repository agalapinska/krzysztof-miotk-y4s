{
  "version": "2.14",
  "variables": {
    "color.violet": { "type": "color", "value": "#6C4BF0" },
    "color.violetDeep": { "type": "color", "value": "#4F2DC8" },
    "color.violetDeepBtn": { "type": "color", "value": "#2E1065" },
    "color.lavender": { "type": "color", "value": "#A399FD" },
    "color.ink": { "type": "color", "value": "#15172C" },
    "color.dark": { "type": "color", "value": "#0E1023" },
    "color.black": { "type": "color", "value": "#000000" },
    "color.muted": { "type": "color", "value": "#585B6E" },
    "color.soft": { "type": "color", "value": "#9094A6" },
    "color.gray": { "type": "color", "value": "#F1F1F5" },
    "color.dim": { "type": "color", "value": "#262051" },
    "color.dimStrong": { "type": "color", "value": "#322A68" },
    "font.display": { "type": "string", "value": "Nexa" },
    "font.body": { "type": "string", "value": "Inter" },
    "font.mono": { "type": "string", "value": "Geist Mono" }
  },
  "children": [
    {
      "id": "y4s-original",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 1440,
      "layout": "vertical",
      "gap": 0,
      "fill": "#FFFFFF",
      "height": "fit_content",
      "children": [
        {
          "id": "o-nav",
          "type": "frame",
          "layout": "horizontal",
          "alignItems": "center",
          "gap": 36,
          "padding": [24, 100, 24, 100],
          "width": "fill_container",
          "children": [
            { "id": "o-nav-logo", "type": "rectangle", "width": 200, "height": 30, "fill": { "type": "image", "url": "./assets/logo.svg", "mode": "fit" } },
            {
              "id": "o-nav-menu",
              "type": "frame",
              "layout": "horizontal",
              "gap": 26,
              "alignItems": "center",
              "width": "fill_container",
              "children": [
                { "id": "o-nav-lbl", "type": "text", "content": "Usługi :", "fontFamily": "$font.body", "fontWeight": "bold", "fontSize": 16, "fill": "$color.ink" },
                { "id": "o-nav-l1", "type": "text", "content": "Badania UX", "fontFamily": "$font.body", "fontSize": 16, "fill": "$color.ink" },
                { "id": "o-nav-l2", "type": "text", "content": "Segmentacja klientów", "fontFamily": "$font.body", "fontSize": 16, "fill": "$color.ink" },
                { "id": "o-nav-l3", "type": "text", "content": "Audyt UX", "fontFamily": "$font.body", "fontSize": 16, "fill": "$color.ink" },
                { "id": "o-nav-l4", "type": "text", "content": "Konsultacje", "fontFamily": "$font.body", "fontSize": 16, "fill": "$color.ink" },
                { "id": "o-nav-l5", "type": "text", "content": "Wystąpienia", "fontFamily": "$font.body", "fontSize": 16, "fill": "$color.ink" }
              ]
            },
            {
              "id": "o-nav-cta",
              "type": "frame",
              "layout": "horizontal",
              "alignItems": "center",
              "gap": 12,
              "padding": [15, 22, 15, 22],
              "fill": "$color.gray",
              "children": [
                { "id": "o-nav-cta-t", "type": "text", "content": "Umów rozmowę", "fontFamily": "$font.body", "fontSize": 16, "fill": "$color.ink" },
                { "id": "o-nav-cta-i", "type": "icon", "library": "lucide", "icon": "calendar-plus", "width": 22, "height": 22, "fill": "$color.ink" }
              ]
            }
          ]
        },
        {
          "id": "o-hero",
          "type": "frame",
          "layout": "horizontal",
          "gap": 40,
          "padding": [90, 100, 120, 100],
          "alignItems": "center",
          "width": "fill_container",
          "children": [
            {
              "id": "o-hero-left",
              "type": "frame",
              "layout": "vertical",
              "gap": 26,
              "width": 700,
              "children": [
                { "id": "o-hero-h1", "type": "text", "content": "Zamieniam wiedzę o klientach\nw wzrost Twojego biznesu.", "fontFamily": "$font.display", "fontSize": 56, "lineHeight": 64, "letterSpacing": -1, "fill": "$color.ink", "textGrowth": "fixed-width", "width": 700 },
                { "id": "o-hero-sub", "type": "text", "content": "Wykorzystuję wiedzę o użytkownikach\nw wartość dla biznesu.", "fontFamily": "$font.body", "fontSize": 24, "lineHeight": 35, "fill": "$color.muted" },
                {
                  "id": "o-hero-clients",
                  "type": "frame",
                  "layout": "horizontal",
                  "gap": 26,
                  "alignItems": "center",
                  "padding": [64, 0, 0, 0],
                  "children": [
                    { "id": "o-hc-lbl", "type": "text", "content": "PRACOWAŁEM Z:", "fontFamily": "$font.mono", "fontSize": 15, "letterSpacing": 1.5, "fill": "$color.ink" },
                    { "id": "o-hc-1", "type": "text", "content": "PayU", "fontFamily": "$font.body", "fontSize": 17, "fill": "$color.muted" },
                    { "id": "o-hc-2", "type": "text", "content": "BLIK", "fontFamily": "$font.body", "fontSize": 17, "fill": "$color.muted" },
                    { "id": "o-hc-3", "type": "text", "content": "OLX", "fontFamily": "$font.body", "fontSize": 17, "fill": "$color.muted" },
                    { "id": "o-hc-4", "type": "text", "content": "mObywatel", "fontFamily": "$font.body", "fontSize": 17, "fill": "$color.muted" },
                    { "id": "o-hc-5", "type": "text", "content": "mBank", "fontFamily": "$font.body", "fontSize": 17, "fill": "$color.muted" },
                    { "id": "o-hc-6", "type": "text", "content": "OtoMoto", "fontFamily": "$font.body", "fontSize": 17, "fill": "$color.muted" }
                  ]
                },
                {
                  "id": "o-hero-btn",
                  "type": "frame",
                  "layout": "horizontal",
                  "children": [
                    {
                      "id": "o-hero-btn-main",
                      "type": "frame",
                      "layout": "horizontal",
                      "alignItems": "center",
                      "gap": 12,
                      "padding": [17, 26, 17, 26],
                      "fill": "$color.violet",
                      "children": [
                        { "id": "o-hb-i", "type": "icon", "library": "lucide", "icon": "calendar-plus", "width": 20, "height": 20, "fill": "#FFFFFF" },
                        { "id": "o-hb-t", "type": "text", "content": "Umów się na rozmowę online!", "fontFamily": "$font.body", "fontSize": 17, "fill": "#FFFFFF" }
                      ]
                    },
                    {
                      "id": "o-hero-btn-arrow",
                      "type": "frame",
                      "layout": "horizontal",
                      "alignItems": "center",
                      "padding": [17, 15, 17, 15],
                      "fill": "$color.violetDeep",
                      "children": [
                        { "id": "o-hb-a", "type": "icon", "library": "lucide", "icon": "arrow-right", "width": 20, "height": 20, "fill": "#FFFFFF" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "o-hero-collage",
              "type": "frame",
              "layout": "none",
              "width": 520,
              "height": 560,
              "children": [
                { "id": "o-col-p3", "type": "rectangle", "x": 395, "y": 90, "width": 125, "height": 400, "opacity": 0.85, "fill": { "type": "image", "url": "./assets/img/duo-panel.jpg", "mode": "fill" } },
                { "id": "o-col-p2", "type": "rectangle", "x": 310, "y": 40, "width": 165, "height": 460, "fill": { "type": "image", "url": "./assets/img/duo-warsztaty.jpg", "mode": "fill" } },
                { "id": "o-col-p1", "type": "rectangle", "x": 0, "y": 0, "width": 375, "height": 537, "fill": { "type": "image", "url": "./assets/img/duo-hero-dark.jpg", "mode": "fill" } },
                {
                  "id": "o-col-sticker",
                  "type": "frame",
                  "x": -10,
                  "y": 500,
                  "layout": "horizontal",
                  "padding": [9, 16, 9, 16],
                  "fill": "#1C1145",
                  "rotation": -3,
                  "children": [
                    { "id": "o-col-sticker-t", "type": "text", "content": "DECISION GUY W QUALE UX", "fontFamily": "$font.mono", "fontSize": 13, "letterSpacing": 1.8, "fill": "#FFFFFF" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "o-services",
          "type": "frame",
          "layout": "vertical",
          "gap": 56,
          "padding": [100, 100, 110, 100],
          "width": "fill_container",
          "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135, "colors": [ { "color": "#170A33", "position": 0 }, { "color": "#2A0D71", "position": 0.45 }, { "color": "#4316C9", "position": 1 } ] },
          "children": [
            {
              "id": "o-svc-head",
              "type": "frame",
              "layout": "horizontal",
              "gap": 40,
              "justifyContent": "space_between",
              "width": "fill_container",
              "children": [
                { "id": "o-svc-h2", "type": "text", "content": "Usługi, które łączą UX\nz wynikiem biznesowym", "fontFamily": "$font.display", "fontSize": 44, "lineHeight": 52, "fill": "#FFFFFF" },
                {
                  "id": "o-svc-intro",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 12,
                  "width": 560,
                  "children": [
                    { "id": "o-svc-p1", "type": "text", "content": "Od pojedynczych badań po stałe wsparcie strategiczne. Wybierz format dopasowany do etapu, na którym jest Twój produkt.", "fontFamily": "$font.body", "fontSize": 18, "lineHeight": 27, "fill": "#FFFFFF", "textGrowth": "fixed-width", "width": 560 },
                    { "id": "o-svc-p2", "type": "text", "content": "[Kliknij na wybraną usługę, aby przeczytać przykładowe wdrożenie i przeczytać moje przemyślenia (artykuły) na ten temat.]", "fontFamily": "$font.body", "fontSize": 15, "lineHeight": 22, "fill": "#FFFFFFB8", "textGrowth": "fixed-width", "width": 560 }
                  ]
                }
              ]
            },
            {
              "id": "o-svc-panel",
              "type": "frame",
              "layout": "horizontal",
              "gap": 60,
              "padding": [64, 72, 64, 72],
              "fill": "#FFFFFF0D",
              "width": "fill_container",
              "children": [
                {
                  "id": "o-svc-col1",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 44,
                  "width": "fill_container",
                  "children": [
                    { "id": "o-s1", "type": "frame", "layout": "horizontal", "gap": 20, "alignItems": "center", "children": [ { "id": "o-s1-i", "type": "icon", "library": "lucide", "icon": "search", "width": 26, "height": 26, "fill": "#FFFFFF" }, { "id": "o-s1-t", "type": "text", "content": "Badania UX", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" } ] },
                    { "id": "o-s2", "type": "frame", "layout": "horizontal", "gap": 20, "alignItems": "center", "children": [ { "id": "o-s2-i", "type": "icon", "library": "lucide", "icon": "pie-chart", "width": 26, "height": 26, "fill": "#FFFFFF" }, { "id": "o-s2-t", "type": "text", "content": "Segmentacja klientów", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" } ] },
                    { "id": "o-s3", "type": "frame", "layout": "horizontal", "gap": 20, "alignItems": "center", "children": [ { "id": "o-s3-i", "type": "icon", "library": "lucide", "icon": "file-check", "width": 26, "height": 26, "fill": "#FFFFFF" }, { "id": "o-s3-t", "type": "text", "content": "Audyt UX", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" } ] }
                  ]
                },
                {
                  "id": "o-svc-col2",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 44,
                  "width": "fill_container",
                  "children": [
                    { "id": "o-s4", "type": "frame", "layout": "horizontal", "gap": 20, "alignItems": "center", "children": [ { "id": "o-s4-i", "type": "icon", "library": "lucide", "icon": "users", "width": 26, "height": 26, "fill": "#FFFFFF" }, { "id": "o-s4-t", "type": "text", "content": "Konsultacje i mentoring", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" } ] },
                    { "id": "o-s5", "type": "frame", "layout": "horizontal", "gap": 20, "alignItems": "center", "children": [ { "id": "o-s5-i", "type": "icon", "library": "lucide", "icon": "wand", "width": 26, "height": 26, "fill": "#FFFFFF" }, { "id": "o-s5-t", "type": "text", "content": "Dyrektor UX", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" } ] },
                    {
                      "id": "o-s6",
                      "type": "frame",
                      "layout": "horizontal",
                      "gap": 20,
                      "children": [
                        { "id": "o-s6-i", "type": "icon", "library": "lucide", "icon": "megaphone", "width": 26, "height": 26, "fill": "#FFFFFF" },
                        {
                          "id": "o-s6-col",
                          "type": "frame",
                          "layout": "vertical",
                          "gap": 10,
                          "children": [
                            { "id": "o-s6-t", "type": "text", "content": "Wystąpienia i szkolenia", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" },
                            { "id": "o-s6-d", "type": "text", "content": "Zaproś mnie na konferencję lub podnieś\nkompetencje swojego zespołu.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "#FFFFFFD9" }
                          ]
                        }
                      ]
                    }
                  ]
                },
                { "id": "o-svc-photo", "type": "rectangle", "width": 135, "height": 130, "fill": { "type": "image", "url": "./assets/img/krzysztof-prelekcja.jpg", "mode": "fill" } }
              ]
            }
          ]
        },
        {
          "id": "o-method",
          "type": "frame",
          "layout": "vertical",
          "gap": 40,
          "padding": [90, 100, 110, 100],
          "width": "fill_container",
          "fill": "$color.black",
          "children": [
            { "id": "o-m-h2", "type": "text", "content": "Od pytania biznesowego do decyzji\nz moim wsparciem", "fontFamily": "$font.display", "fontSize": 44, "lineHeight": 57, "fill": "$color.dimStrong" },
            {
              "id": "o-m-stats",
              "type": "frame",
              "layout": "horizontal",
              "gap": 20,
              "padding": [24, 0, 0, 0],
              "width": "fill_container",
              "children": [
                { "id": "o-st1", "type": "frame", "layout": "vertical", "gap": 8, "padding": [26, 28, 34, 28], "fill": "#FFFFFF", "width": "fill_container", "children": [ { "id": "o-st1-n", "type": "text", "content": "2500+", "fontFamily": "$font.display", "fontWeight": "bold", "fontSize": 46, "fill": "#6D28D9" }, { "id": "o-st1-t", "type": "text", "content": "sesji badawczych\nw kilkudziesięciu firmach.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.muted" } ] },
                { "id": "o-st2", "type": "frame", "layout": "vertical", "gap": 8, "padding": [26, 28, 34, 28], "fill": "#FFFFFF", "width": "fill_container", "children": [ { "id": "o-st2-n", "type": "text", "content": "#1", "fontFamily": "$font.display", "fontWeight": "bold", "fontSize": 46, "fill": "#6D28D9" }, { "id": "o-st2-t", "type": "text", "content": "jedyny kierownik studiów UX research\nw Polsce.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.muted" } ] },
                { "id": "o-st3", "type": "frame", "layout": "vertical", "gap": 8, "padding": [26, 28, 34, 28], "fill": "#FFFFFF", "width": "fill_container", "children": [ { "id": "o-st3-n", "type": "text", "content": "2017", "fontFamily": "$font.display", "fontWeight": "bold", "fontSize": 46, "fill": "#6D28D9" }, { "id": "o-st3-t", "type": "text", "content": "od tego roku wykładam i uczę UX.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.muted" } ] },
                { "id": "o-st4", "type": "frame", "layout": "vertical", "gap": 8, "padding": [26, 28, 34, 28], "fill": "#FFFFFF", "width": "fill_container", "children": [ { "id": "o-st4-n", "type": "text", "content": "50–100", "fontFamily": "$font.display", "fontWeight": "bold", "fontSize": 46, "fill": "#6D28D9" }, { "id": "o-st4-t", "type": "text", "content": "badaczy rocznie korzysta z mojego know-how.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.muted" } ] }
              ]
            },
            {
              "id": "o-m-banner",
              "type": "frame",
              "layout": "horizontal",
              "gap": 26,
              "alignItems": "center",
              "padding": [28, 34, 28, 34],
              "width": "fill_container",
              "fill": { "type": "gradient", "gradientType": "linear", "rotation": 120, "colors": [ { "color": "#3B0F8E", "position": 0 }, { "color": "#4C1D95", "position": 0.45 }, { "color": "#2A0D71", "position": 1 } ] },
              "children": [
                { "id": "o-mb-i", "type": "icon", "library": "lucide", "icon": "target", "width": 34, "height": 34, "fill": "#FFFFFF" },
                { "id": "o-mb-t", "type": "text", "content": "Dlatego nie dostarczam raportów do szuflady: pokazuję, gdzie tracisz\npieniądze w doświadczeniu klienta i co zrobić, żeby je odzyskać.", "fontFamily": "$font.body", "fontSize": 19, "lineHeight": 28, "fill": "#FFFFFF" }
              ]
            },
            {
              "id": "o-m-checks",
              "type": "frame",
              "layout": "horizontal",
              "gap": 34,
              "padding": [32, 0, 0, 0],
              "width": "fill_container",
              "children": [
                { "id": "o-ck1", "type": "frame", "layout": "horizontal", "gap": 12, "width": "fill_container", "children": [ { "id": "o-ck1-i", "type": "icon", "library": "lucide", "icon": "check", "width": 20, "height": 20, "fill": "$color.dim" }, { "id": "o-ck1-t", "type": "text", "content": "Widziałem dziesiątki produktów od środka. Łączę badania jakościowe i ilościowe z twardą analityką.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.dim", "textGrowth": "fixed-width", "width": 250 } ] },
                { "id": "o-ck2", "type": "frame", "layout": "horizontal", "gap": 12, "width": "fill_container", "children": [ { "id": "o-ck2-i", "type": "icon", "library": "lucide", "icon": "check", "width": 20, "height": 20, "fill": "$color.dim" }, { "id": "o-ck2-t", "type": "text", "content": "Każdą rekomendację wiążę z metryką biznesową: konwersją, LTV, retencją.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.dim", "textGrowth": "fixed-width", "width": 250 } ] },
                { "id": "o-ck3", "type": "frame", "layout": "horizontal", "gap": 12, "width": "fill_container", "children": [ { "id": "o-ck3-i", "type": "icon", "library": "lucide", "icon": "check", "width": 20, "height": 20, "fill": "$color.dim" }, { "id": "o-ck3-t", "type": "text", "content": "Jako jedyny kierownik studiów UX research w Polsce uczę tego, co sam praktykuję.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.dim", "textGrowth": "fixed-width", "width": 250 } ] },
                { "id": "o-ck4", "type": "frame", "layout": "horizontal", "gap": 12, "width": "fill_container", "children": [ { "id": "o-ck4-i", "type": "icon", "library": "lucide", "icon": "check", "width": 20, "height": 20, "fill": "$color.dim" }, { "id": "o-ck4-t", "type": "text", "content": "Zespoły, z którymi pracuję, po współpracy potrafią działać samodzielnie.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "$color.dim", "textGrowth": "fixed-width", "width": 250 } ] }
              ]
            }
          ]
        },
        {
          "id": "o-process",
          "type": "frame",
          "layout": "vertical",
          "gap": 70,
          "padding": [90, 100, 80, 100],
          "width": "fill_container",
          "fill": { "type": "gradient", "gradientType": "linear", "rotation": 140, "colors": [ { "color": "#1D0B52", "position": 0 }, { "color": "#33107E", "position": 0.5 }, { "color": "#4C16C9", "position": 1 } ] },
          "children": [
            { "id": "o-p-h2", "type": "text", "content": "Jak wygląda współpraca?", "fontFamily": "$font.display", "fontSize": 44, "fill": "#FFFFFF" },
            {
              "id": "o-p-grid",
              "type": "frame",
              "layout": "horizontal",
              "gap": 40,
              "width": "fill_container",
              "children": [
                { "id": "o-p1", "type": "frame", "layout": "vertical", "gap": 14, "width": "fill_container", "children": [ { "id": "o-p1-i", "type": "icon", "library": "lucide", "icon": "message-square", "width": 30, "height": 30, "fill": "#FFFFFF" }, { "id": "o-p1-h", "type": "text", "content": "Zrozumienie celu", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" }, { "id": "o-p1-t", "type": "text", "content": "Zaczynam tam, gdzie boli biznes: od metryki, którą chcesz poprawić.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "#FFFFFFD9", "textGrowth": "fixed-width", "width": 250 } ] },
                { "id": "o-p2", "type": "frame", "layout": "vertical", "gap": 14, "padding": [130, 0, 0, 0], "width": "fill_container", "children": [ { "id": "o-p2-i", "type": "icon", "library": "lucide", "icon": "search", "width": 30, "height": 30, "fill": "#FFFFFF" }, { "id": "o-p2-h", "type": "text", "content": "Badanie", "fontFamily": "$font.display", "fontSize": 28, "fill": "#FFFFFF" }, { "id": "o-p2-t", "type": "text", "content": "Po 2500+ sesjach wiem, którą metodę dobrać.", "fontFamily": "$font.body", "fontSize": 17, "lineHeight": 25, "fill": "#FFFFFFD9", "textGrowth": "fixed-width", "width": 250 } ] },
