                          "name": "Nie bez powodu jestem jedynym kierowniki",
                          "context": "p",
                          "fill": "#3a3d52",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Od 2017 roku wykładam i uczę badań UX na studiach, konferencjach i w firmach. Rocznie z mojego know-how korzysta od 50 do 100 badaczy.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
